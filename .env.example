# Copy to .env and adjust. Both the web app and the worker read these.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/llms_txt
# Optional: debug, info (default), warn or error.
LOG_LEVEL=
# Optional, worker: sites crawled at once (default 10).
PIPELINE_RUN_CONCURRENCY=
# Optional, worker: most pages one run fetches (default 200).
CRAWL_PAGE_BUDGET=
# Optional, web: new workspaces one IP may create per hour (default 10).
SUBMISSIONS_PER_IP_PER_HOUR=
# Optional, web: proxies in front of the app that append to X-Forwarded-For (default 1).
TRUSTED_PROXY_HOPS=
# Optional, web: the login for the app and REST API (default user1 / pass1). Change both
# on any deployment, because the defaults are public.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Needed in production. Without it the worker skips LLM page assessment and summaries
# and uses heuristics, which is only meant for local development and tests.
ANTHROPIC_API_KEY=
