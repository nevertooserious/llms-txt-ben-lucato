# Copy to .env and adjust. Both the web app and the worker read these.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/llms_txt
# Optional: debug, info (default), warn or error.
LOG_LEVEL=
# Optional, worker: sites crawled at once (default 10).
PIPELINE_RUN_CONCURRENCY=
# Optional, worker and web: most pages one run fetches (default 200). The web app shows it.
CRAWL_PAGE_BUDGET=
# Optional, web: the login for the app and REST API (default user1 / pass1). Change both
# on any deployment, because the defaults are public.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Required by the worker, unless LLM_CLIENT=stub.
ANTHROPIC_API_KEY=
# Set to stub to run without a model, for local development and tests. Never in production.
LLM_CLIENT=
# Optional, worker: set to true to crawl without reading a site's own llms.txt. Only the
# hub eval sets it (evals/hub/README.md), so that file cannot shape the one scored against it.
IGNORE_EXISTING_LLMS_TXT=
