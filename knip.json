{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ]
    },
    "e2e": {
      "entry": [
        "tests/**/*.test.ts",
        "fixture-sites/*/routes.ts"
      ],
      "ignore": [
        "fixture-sites/**/*.js"
      ]
    }
  }
}
