    {
      "id": "k1",
      "kind": "fact",
      "description": "Turborepo is a build system (positioned as 'the build system for coding agents') for JavaScript/TypeScript monorepos, providing incremental task running, local and remote caching, and parallel execution; audience is JS/TS developers, monorepo maintainers, and platform/DX teams",
      "urls": []
    },
    {
      "id": "k2",
      "kind": "fact",
      "description": "Tasks/pipelines are configured in a turbo.json file and run via the `turbo` CLI; `turbo prune` produces lightweight monorepo subsets for deploys",
      "urls": []
